---
/**
 * Swiss-grid content slide: black title panel over columns 1–4, content a
 * 7-column block centred in the white area to the right of the panel.
 * Everything hangs from the same line at y = 200.
 */
interface Props {
  id?: string;
  title: string[];
  subtitle?: string;
  section: string;
  kind?: string;
}
const { id, title, subtitle, section, kind = 'content' } = Astro.props;
---

<section id={id} class="slide absolute inset-0 overflow-hidden bg-white font-sans text-black" data-slide={kind}>
  <div class="absolute inset-y-0 left-0 w-[650px] bg-black"></div>

  <div class="absolute top-[40px] left-[40px] text-[20px] leading-[0.8] font-bold tracking-[-0.05em] text-white" data-a="lines">
    <span data-line>Applied</span>
    <span data-line>Archive</span>
  </div>
  <div class="label absolute top-[40px] right-[40px]" data-a="lines"><span data-line>L4E × A.A.A.</span></div>
  <div class="label absolute bottom-[40px] left-[40px] w-[590px] text-white/50" data-a="lines">
    <span data-line>{section}</span>
  </div>
  <div class="label absolute right-[40px] bottom-[40px]" data-a="lines">
    <span data-line><span data-page-num>00</span> / <span data-page-total>00</span></span>
  </div>

  <div class="absolute inset-x-[40px] top-(--hang) grid grid-cols-12 gap-x-[20px]">
    <div class="col-span-4 text-white">
      <h2 class="text-[72px] leading-[0.97] font-medium tracking-[-0.02em]" data-a="lines">
        {title.map((line) => <span data-line>{line}</span>)}
      </h2>
      {
        subtitle && (
          <p class="mt-[32px] w-[445px] text-[18px] leading-[1.3] text-[#b4b4b4]" data-a="lines">
            <span data-line>{subtitle}</span>
          </p>
        )
      }
    </div>
    <!-- Content keeps its 7-column width but is shifted left 62.5px so it sits centred
         in the white area (650–1920): (650 + 1920) / 2 − (815 + 1880) / 2 = −62.5 -->
    <div class="relative -left-[62.5px] col-span-7 col-start-6">
      <slot />
    </div>
  </div>
</section>
