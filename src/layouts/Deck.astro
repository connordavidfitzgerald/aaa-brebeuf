---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/FavoritPro-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/FavoritPro-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/FavoritPro-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/BradfordLL-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://stream.mux.com" />
    <link rel="preconnect" href="https://image.mux.com" />
  </head>
  <body class="select-none">
    <slot />
    <script>
      import '../scripts/deck';
    </script>
  </body>
</html>
